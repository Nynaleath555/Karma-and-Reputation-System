  ];

  // ---------------------------------------------------------------------------
  // Visibility / consequences
  // ---------------------------------------------------------------------------

  const PUBLIC_INDICATORS = [
    /\b(?:news|newspaper|reporters?|journalists?|broadcast|television|tv|radio|viral|social media|internet)\b/i,

    /\b(?:camera|cameras|security footage|recorded|video footage|livestream)\b/i,

    /\b(?:police report|official report|authorities reported|government statement)\b/i,

    /\b(?:crowd|thousands?|hundreds?|dozens? of people|everyone saw|witnesses?)\b/i,
  ];

  const SECRET_INDICATORS = [
    /\b(?:secretly|unseen|undetected|without witnesses?|no witnesses?|nobody saw|no one saw|nobody knows|no one knows|alone|in secret|hidden|concealed|covered it up|cover it up|left no evidence)\b/i,
  ];

  const FAILURE_INDICATORS =
    /\b(?:failed|missed|didn't succeed|did not succeed|too late|was stopped|was prevented|couldn't|could not|was unable to)\b/i;

  const POSITIVE_OUTCOME =
    /\b(?:saved|rescued|survived|safe|alive|protected|evacuated)\b/i;

  const inferVisibility = (input, output) => {
    const combined = `${input || ""} ${output || ""}`;

    if (
      PUBLIC_INDICATORS.some((re) =>
        re.test(combined)
      )
    ) {
      return "public";
    }

    if (
      SECRET_INDICATORS.some((re) =>
        re.test(combined)
      )
    ) {
      return "private";
    }

    return "witnessed";
  };

  const extractConsequenceCounts = (output) => {
    const src = cleanText(output);

    let casualties = 0;
    let saved = 0;
    let injured = 0;

    const numberWords = {
      a: 1,
      one: 1,
      two: 2,
      three: 3,
      four: 4,
      five: 5,
      six: 6,
      seven: 7,
      eight: 8,
      nine: 9,
      ten: 10,
      dozen: 12,
      dozens: 12,
      scores: 20,
      hundreds: 100,
      thousands: 1000,
    };

    const addMatches = (re, target) => {
      re.lastIndex = 0;

      let m;

      while ((m = re.exec(src)) !== null) {
        const token = String(m[1] || "")
          .toLowerCase()
          .replace(/,/g, "");

        const n = /^\d+$/.test(token)
          ? Number(token)
          : numberWords[token] || 1;

        if (target === "casualties") casualties += n;
        else if (target === "saved") saved += n;
        else if (target === "injured") injured += n;
      }
    };

    const qty =
      /(\d{1,3}(?:,\d{3})*|one|two|three|four|five|six|seven|eight|nine|ten|dozen|dozens|scores|hundreds|thousands)/;

    addMatches(
      new RegExp(
        `\\b${qty.source}\\s+(?:people|civilians|bystanders|victims|persons)\\s+(?:were\\s+)?(?:killed|dead|died|die)\\b`,
        "gi"
      ),
      "casualties"
    );

    addMatches(
      new RegExp(
        `\\b(?:kill(?:s|ed|ing)?|murder(?:s|ed|ing)?|slaughter(?:s|ed|ing)?)\\s+${qty.source}\\s+(?:people|civilians|bystanders|victims|persons)\\b`,
        "gi"
      ),
      "casualties"
    );

    addMatches(
      new RegExp(
        `\\b${qty.source}\\s+(?:people|civilians|bystanders|victims|persons)\\s+(?:were\\s+)?(?:saved|rescued|evacuated)\\b`,
        "gi"
      ),
      "saved"
    );

    addMatches(
      new RegExp(
        `\\b(?:save[sd]?|rescue[sd]?|evacuat(?:ed|es|e))\\s+${qty.source}\\s+(?:people|civilians|bystanders|victims|persons)\\b`,
        "gi"
      ),
      "saved"
    );

    addMatches(
      new RegExp(
        `\\b${qty.source}\\s+(?:people|civilians|bystanders|victims|persons)\\s+(?:were\\s+)?(?:injured|wounded)\\b`,
        "gi"
      ),
      "injured"
    );

    if (
      !casualties &&
      /\b(?:someone|a civilian|a bystander|a victim)\b[\s\S]{0,60}\b(?:killed|died|dies|dead)\b/i.test(
        src
      )
    ) {
      casualties = 1;
    }

    if (
      !saved &&
      /\b(?:someone|a civilian|a bystander|a victim)\b[\s\S]{0,60}\b(?:saved|rescued|evacuated)\b/i.test(
        src
      )
    ) {
      saved = 1;
    }

    if (
      !injured &&
      /\b(?:someone|a civilian|a bystander|a victim)\b[\s\S]{0,60}\b(?:injured|wounded)\b/i.test(
        src
      )
    ) {
      injured = 1;
    }

    if (
      /\b(?:dozens?|many)\b[\s\S]{0,40}\b(?:killed|died|dead)\b/i.test(
        src
      )
    ) {
      casualties = Math.max(casualties, 12);
    }

    if (
      /\bhundreds?\b[\s\S]{0,40}\b(?:killed|died|dead)\b/i.test(
        src
      )
    ) {
      casualties = Math.max(casualties, 100);
    }

    return {
      casualties,
      saved,
      injured,
    };
  };

  // ---------------------------------------------------------------------------
  // Killing evaluation
  // ---------------------------------------------------------------------------

  const evaluateKilling = (candidate, output) => {
    const context = lower(
      `${candidate.sentence || ""} ${output || ""}`
    );

    const clearlyUnjustified =
      /\b(?:for fun|for pleasure|for sport|enjoyed killing|wanted to kill|cold[- ]blooded|innocent|unprovoked|helpless|defenseless|defenceless|revenge|execute an innocent|murder an innocent)\b/i.test(
        context
      );

    const immediateThreat =
      /\b(?:about to kill|trying to kill|attacking|attacking me|attacking us|shoot(?:ing)? at me|shoot(?:ing)? at us|threatening|immediate threat|life[- ]or[- ]death|deadly attack)\b/i.test(
        context
      );

    const selfDefense =
      /\b(?:self[- ]defense|self[- ]defence|defend(?:ed|ing)? myself|protect(?:ed|ing)? myself|defending myself|defend(?:ed|ing)? us|protect(?:ed|ing)? us)\b/i.test(
        context
      );

    const protectingOthers =
      /\b(?:protect(?:ed|ing)? (?:her|him|them|someone|others|people|civilians)|save(?:d|ing)? (?:her|him|them|someone|others|people|civilians)|defend(?:ed|ing)? (?:her|him|them|someone|others|people|civilians))\b/i.test(
        context
      );

    const dangerousTarget =
      /\b(?:terrorist|killer|murderer|mass murderer|serial killer|violent criminal|armed attacker|villain|enemy combatant|dangerous criminal)\b/i.test(
        context
      );

    const revenge =
      /\b(?:revenge|retaliation|payback|vengeance|avenged|avenge)\b/i.test(
        context
      );

    const combat =
      /\b(?:combat|battle|war|fight|fighting|soldier|enemy)\b/i.test(
        context
      );

    if (clearlyUnjustified) return -32;
    if (revenge) return -25;
    if (selfDefense && immediateThreat) return -5;
    if (selfDefense) return -7;
    if (protectingOthers && immediateThreat) return -8;
    if (dangerousTarget && immediateThreat) return -10;
    if (dangerousTarget) return -12;
    if (protectingOthers) return -10;
    if (combat) return -15;

    return -20;
  };

  // ---------------------------------------------------------------------------
  // Defensive/rescue context
  // ---------------------------------------------------------------------------

  const DEFENSIVE_SCENE =
    /\b(?:attacker|attackers|assailant|assailants|mugger|muggers|criminals?|men|man|woman|people)\b[\s\S]{0,120}\b(?:grabs?|grabbed|corners?|cornered|threatens?|threatened|attacks?|attacked|lunges?|lunged|tries? to hit|tries? to hurt|tries? to kill|tackles?|tackled|beats?|beaten|shoots?|shot|stabs?|stabbed)\b/i;

  const PROTECTIVE_CONTEXT =
    /\b(?:save|saved|rescue|rescued|protect|protected|defend|defended|shield|shielded|help|helped|escape|escaped|scap(?:e|ed|es|ing)|get away|get to safety|get her to safety|get him to safety|get them to safety|out of danger|safe|safely)\b/i;

  const DEFENSIVE_FORCE =
    /\b(?:push(?:ed|es|ing)?|throw(?:s|ing)?|threw|knock(?:ed|s|ing)?|repel(?:led|s|ing)?|drive(?:n|s)?|drove|force(?:d|s|ing)?|slam(?:med|s|ming)?|blast(?:ed|s|ing)?|hit(?:s|ting)?|strike(?:s|ing)?|kick(?:ed|s|ing)?|punch(?:ed|s|ing)?)\b/i;

  const isDefensiveForceContext = (text) => {
    const src = String(text ?? "");

    const hasThreat =
      DEFENSIVE_SCENE.test(src) ||
      /\b(?:someone|a woman|a man|the victim|the civilian)\b[\s\S]{0,80}\b(?:attacked|grabbed|cornered|threatened|in danger)\b/i.test(
        src
      );

    return (
      hasThreat &&
      PROTECTIVE_CONTEXT.test(src) &&
      DEFENSIVE_FORCE.test(src)
    );
  };

  // ---------------------------------------------------------------------------
  // Rescue target extraction
  // ---------------------------------------------------------------------------

  const extractRescueTarget = (candidate, sourceText) => {
    const src = cleanText(sourceText);

    const patterns = [
      /\b(?:help(?:ed|s|ing)?|assist(?:ed|s|ing)?)\s+([A-Z][a-z]+|him|her|them|someone|somebody|the victim|the civilian|the woman|the man)\b[\s\S]{0,55}\b(?:escape|escaped|escaping|scape|scaped|scaping|get away|flee|fled|get out)\b/i,

      /\b(?:get|got|getting|lead|led|leading|guide|guided|guiding|escort|escorted|escorting|carry|carried|carrying|pull|pulled|pulling)\s+([A-Z][a-z]+|him|her|them|someone|somebody|the victim|the civilian|the woman|the man)\b[\s\S]{0,35}\b(?:safety|danger|the area|there|here)\b/i,

      /\b(?:save[sd]?|rescue[sd]?|protect(?:ed|s|ing)?|defend(?:ed|s|ing)?|shield(?:ed|s|ing)?)\s+([A-Z][a-z]+|him|her|them|someone|somebody|the victim|the civilian|the woman|the man)\b/i,
    ];

    for (const re of patterns) {
      const m = re.exec(src);

      if (m && m[1]) {
        return cleanText(m[1]);
      }
    }

    return "";
  };

  const normalizeTarget = (value) =>
    cleanText(value)
      .toLowerCase()
      .replace(/^(?:the|a|an)\s+/, "");

  // ---------------------------------------------------------------------------
  // Candidate descriptions
  // ---------------------------------------------------------------------------

  const buildActionDescription = (candidate) => {
    const rule = candidate.rule;
    const sentence = cleanText(candidate.sentence);
    const matched = cleanText(candidate.matched);

    let target = "";

    if (sentence && matched) {
      const idx = sentence
        .toLowerCase()
        .indexOf(matched.toLowerCase());

      if (idx >= 0) {
        target = sentence
          .slice(idx + matched.length)
          .trim();

        target = target
          .split(
            /\b(?:and then|then|and)\b|[,.!?;]/i
          )[0]
          .trim();

        target = target
          .replace(
            /^(?:to|at|on|for|from|into|with)\s+/i,
            ""
          )
          .trim();
      }
    }

    let desc = rule.label;

    const rescueTarget =
      candidate.target ||
      extractRescueTarget(candidate, sentence);

    if (
      rule.id === "rescue_compound" ||
      rule.id === "rescue"
    ) {
      if (
        rescueTarget &&
        !/^(?:someone|something|the scene)$/i.test(
          rescueTarget
        )
      ) {
        desc = `Rescued ${rescueTarget} from danger`;
      } else {
        desc = "Rescued someone from danger";
      }
    } else if (
      rule.id === "protect" &&
      rescueTarget
    ) {
      desc = `Protected ${rescueTarget} from danger`;
    } else if (
      target &&
      target.length <= 55 &&
      !/^(?:someone|something|the scene)$/i.test(
        target
      )
    ) {
      desc += `: ${target}`;
    }

    if (candidate.attempted) {
      let attempted =
        rule.verb || rule.label;

      if (
        target &&
        target.length <= 55 &&
        !/^(?:someone|something|the scene)$/i.test(
          target
        )
      ) {
        attempted += `: ${target}`;
      }

      desc = `Attempted to ${attempted}`;
    }

    return cap(desc) + ".";
  };

  // ---------------------------------------------------------------------------
  // Candidate detection
  // ---------------------------------------------------------------------------

  const detectCandidates = (input) => {
    const text = cleanText(input);

    if (
      !text ||
      !playerSubjectLikely(text)
    ) {
      return [];
    }

    const candidates = [];

    for (const rule of ACTION_RULES) {
      const found = findFirstMatch(
        text,
        rule.patterns
      );

      if (!found) continue;

      if (isHistorical(text, found.index)) continue;
      if (isHypothetical(text, found.index)) continue;
      if (isNegated(text, found.index)) continue;
      if (isPrevented(text, found.index)) continue;
      if (
        isObservedAnotherActor(
          text,
          found.index
        )
      ) {
        continue;
      }

      if (
        !playerOwnsMatch(
          text,
          found.index
        )
      ) {
        continue;
      }

      const sentence = sentenceAt(
        text,
        found.index
      );

      const attempted = isAttempted(
        text,
        found.index
      );

      let delta = rule.delta;

      if (rule.id === "murder") {
        delta = evaluateKilling(
          {
            sentence,
            matched: found.match,
          },
          ""
        );
      }

      if (attempted) {
        delta = Math.round(
          delta * 0.35
        );
      }

      candidates.push({
        rule,
        matched: found.match,
        index: found.index,
        sentence,
        attempted,
        delta,
        target: extractRescueTarget(
          null,
          text
        ),
        description: "",
      });
    }

    if (!candidates.length) {
      return [];
    }

    const hasRescue =
      candidates.some(
        (c) =>
          c.rule.id ===
            "rescue_compound" ||
          c.rule.id === "rescue"
      );

    const defensiveScene =
      isDefensiveForceContext(text);

    // One rescue/protection sequence = one moral event.
    let filtered = candidates.filter(
      (c) => {
        if (
          hasRescue &&
          [
            "protect",
            "help",
            "prevent_crime",
            "assault",
            "destruction",
          ].includes(c.rule.id)
        ) {
          return false;
        }

        if (
          defensiveScene &&
          [
            "assault",
            "destruction",
          ].includes(c.rule.id)
        ) {
          return false;
        }

        return true;
      }
    );

    const maxMagnitude = Math.max(
      ...filtered.map((c) =>
        Math.abs(c.delta)
      ),
      0
    );

    filtered = filtered.filter(
      (c) => {
        if (
          maxMagnitude >= 25 &&
          Math.abs(c.delta) <= 14 &&
          c.delta * maxMagnitude > 0
        ) {
          return false;
        }

        return true;
      }
    );

    filtered.sort((a, b) => {
      const rank = (c) =>
        c.rule.id ===
        "rescue_compound"
          ? 3
          : c.rule.id === "rescue"
          ? 2
          : 0;

      return (
        rank(b) - rank(a) ||
        Math.abs(b.delta) -
          Math.abs(a.delta)
      );
    });

    const chosen =
      filtered.slice(0, 2);

    for (const c of chosen) {
      c.description =
        buildActionDescription(c);
    }

    return chosen;
  };

  // ---------------------------------------------------------------------------
  // State
  // ---------------------------------------------------------------------------

  const freshState = () => ({
    v: VERSION,

    karma: clamp(
      AID_KARMA_CONFIG.start,
      AID_KARMA_CONFIG.min,
      AID_KARMA_CONFIG.max
    ),

    publicScore: 0,

    events: [],
    deeds: [],
    processed: [],

    pending: null,
    activeScene: null,

    turn: 0,
    cardIndex: -1,
  });

  const normalizeState = (s) => {
    if (
      !s ||
      typeof s !== "object" ||
      Array.isArray(s)
    ) {
      return freshState();
    }

    if (!isNum(s.karma)) {
      s.karma =
        AID_KARMA_CONFIG.start;
    }

    s.karma = clamp(
      s.karma,
      AID_KARMA_CONFIG.min,
      AID_KARMA_CONFIG.max
    );

    if (!isNum(s.publicScore)) {
      s.publicScore = 0;
    }

    s.publicScore = clamp(
      s.publicScore,
      -100,
      100
    );

    if (!Array.isArray(s.events)) {
      s.events = [];
    }

    if (!Array.isArray(s.deeds)) {
      s.deeds = [];
    }

    if (!Array.isArray(s.processed)) {
      s.processed = [];
    }

    if (
      s.pending !== null &&
      typeof s.pending !== "object"
    ) {
      s.pending = null;
    }

    if (
      s.activeScene !== null &&
      typeof s.activeScene !== "object"
    ) {
      s.activeScene = null;
    }

    if (!isNum(s.turn)) {
      s.turn = 0;
    }

    if (!isNum(s.cardIndex)) {
      s.cardIndex = -1;
    }

    s.events =
      s.events.slice(
        -AID_KARMA_CONFIG.maxEvents
      );

    s.deeds =
      s.deeds.slice(
        -AID_KARMA_CONFIG.maxDeeds
      );

    s.processed =
      s.processed.slice(
        -AID_KARMA_CONFIG.maxProcessedKeys
      );

    s.v = VERSION;

    return s;
  };

  const ensureState = () => {
    if (
      !globalThis.state ||
      typeof state !== "object" ||
      Array.isArray(state)
    ) {
      throw new Error(
        "AI Dungeon state is unavailable."
      );
    }

    // Migrate older namespace.
    if (
      !state.aidKarma &&
      state.AID_KARMA &&
      typeof state.AID_KARMA ===
        "object"
    ) {
      state.aidKarma =
        state.AID_KARMA;
    }

    if (
      !state.aidKarma ||
      typeof state.aidKarma !==
        "object" ||
      Array.isArray(
        state.aidKarma
      )
    ) {
      state.aidKarma =
        freshState();
    }

    return normalizeState(
      state.aidKarma
    );
  };

  const rememberProcessed = (
    s,
    key
  ) => {
    if (!key) return;

    s.processed.push(key);

    if (
      s.processed.length >
      AID_KARMA_CONFIG.maxProcessedKeys
    ) {
      s.processed.splice(
        0,
        s.processed.length -
          AID_KARMA_CONFIG.maxProcessedKeys
      );
    }
  };

  const alreadyProcessed = (
    s,
    key
  ) =>
    !!key &&
    s.processed.indexOf(key) >= 0;

  const isRescueRule = (
    candidate
  ) =>
    candidate &&
    [
      "rescue_compound",
      "rescue",
      "protect",
    ].includes(
      candidate.rule.id
    );

  const getCandidateTarget = (
    candidate,
    input
  ) =>
    normalizeTarget(
      candidate &&
        candidate.target
        ? candidate.target
        : extractRescueTarget(
            candidate,
            input
          )
    );

  const isSameActiveRescue = (
    s,
    candidate,
    input
  ) => {
    if (
      !isRescueRule(candidate) ||
      !s.activeScene ||
      !s.activeScene.active
    ) {
      return false;
    }

    if (
      s.turn -
        s.activeScene.turn >
      AID_KARMA_CONFIG.maxActiveSceneTurns
    ) {
      return false;
    }

    const currentTarget =
      getCandidateTarget(
        candidate,
        input
      );

    const previousTarget =
      normalizeTarget(
        s.activeScene.target
      );

    if (
      currentTarget &&
      previousTarget
    ) {
      return (
        currentTarget ===
        previousTarget
      );
    }

    return (
      !currentTarget ||
      !previousTarget
    );
  };

  const updateActiveScene = (
    s,
    candidate,
    input
  ) => {
    if (
      !isRescueRule(candidate)
    ) {
      return;
    }

    s.activeScene = {
      type: "rescue",
      turn: s.turn,
      active: true,
      target:
        getCandidateTarget(
          candidate,
          input
        ),
    };
  };

  // ---------------------------------------------------------------------------
  // Outcome evaluation
  // ---------------------------------------------------------------------------

  const applyOutcome = (
    candidate,
    output
  ) => {
    let delta =
      candidate.delta;

    const consequence =
      extractConsequenceCounts(
        output
      );

    const out = lower(output);

    if (
      candidate.rule.id ===
      "murder"
    ) {
      delta =
        evaluateKilling(
          candidate,
          output
        );

      if (candidate.attempted) {
        delta = Math.round(
          delta * 0.35
        );
      }
    }

    if (
      candidate.attempted &&
      FAILURE_INDICATORS.test(out)
    ) {
      delta = Math.round(
        delta * 0.7
      );
    }

    if (delta > 0) {
      if (
        consequence.casualties >
        0
      ) {
        delta -= Math.min(
          20,
          consequence.casualties *
            3
        );
      }

      if (
        FAILURE_INDICATORS.test(
          out
        ) &&
        !POSITIVE_OUTCOME.test(
          out
        )
      ) {
        delta = Math.min(
          delta,
          3
        );
      }

      if (
        consequence.saved > 1
      ) {
        delta += Math.min(
          15,
          (consequence.saved -
            1) *
            2
        );
      }
    }

    if (delta < 0) {
      if (
        consequence.casualties >
        0
      ) {
        delta -= Math.min(
          35,
          consequence.casualties *
            5
        );
      }

      if (
        consequence.injured >
        0
      ) {
        delta -= Math.min(
          15,
          consequence.injured *
            2
        );
      }

      if (
        consequence.casualties >=
        10
      ) {
        delta = Math.min(
          delta,
          -60
        );
      }

      if (
        /\b(?:bomb|explosion|massacre|terrorist)\b/i.test(
          out
        ) &&
        consequence.casualties >=
          5
      ) {
        delta = Math.min(
          delta,
          -55
        );
      }
    }

    return {
      delta: clamp(
        Math.round(delta),
        -60,
        40
      ),

      consequence,
    };
  };

  // ---------------------------------------------------------------------------
  // Event creation
  // ---------------------------------------------------------------------------

  const addEvent = (
    s,
    input,
    output,
    candidate,
    visibility,
    eventKey,
    fallback = false
  ) => {
    if (
      alreadyProcessed(
        s,
        eventKey
      )
    ) {
      return null;
    }

    // If this is part of the same active rescue,
    // do not count it again.
    if (
      isSameActiveRescue(
        s,
        candidate,
        input
      )
    ) {
      rememberProcessed(
        s,
        eventKey
      );

      safeLog(
        "merged related rescue action",
        {
          target:
            getCandidateTarget(
              candidate,
              input
            ),

          turn: s.turn,
        }
      );

      return null;
    }

    const before = s.karma;

    const outcome = fallback
      ? {
          delta:
            candidate.delta,

          consequence: {
            casualties: 0,
            saved: 0,
            injured: 0,
          },
        }
      : applyOutcome(
          candidate,
          output
        );

    const delta =
      outcome.delta;

    s.karma = clamp(
      s.karma + delta,
      AID_KARMA_CONFIG.min,
      AID_KARMA_CONFIG.max
    );

    // Public reputation changes only when the action is publicly known.
    if (
      visibility === "public"
    ) {
      s.publicScore =
        clamp(
          s.publicScore +
            delta,
          -100,
          100
        );
    }

    const event = {
      turn: s.turn,

      delta,

      before,

      after: s.karma,

      label:
        candidate.description,

      visibility,

      rule:
        candidate.rule.id,

      attempted:
        !!candidate.attempted,

      casualties:
        outcome.consequence
          .casualties,

      saved:
        outcome.consequence
          .saved,

      injured:
        outcome.consequence
          .injured,

      source:
        cleanText(input).slice(
          0,
          180
        ),
    };

    s.events.push(event);

    if (
      s.events.length >
      AID_KARMA_CONFIG.maxEvents
    ) {
      s.events.splice(
        0,
        s.events.length -
          AID_KARMA_CONFIG.maxEvents
      );
    }

    if (
      visibility !== "private"
    ) {
      s.deeds.push({
        delta,

        label:
          candidate.description,

        visibility,

        turn: s.turn,
      });

      if (
        s.deeds.length >
        AID_KARMA_CONFIG.maxDeeds
      ) {
        s.deeds.splice(
          0,
          s.deeds.length -
            AID_KARMA_CONFIG.maxDeeds
        );
      }
    }

    updateActiveScene(
      s,
      candidate,
      input
    );

    rememberProcessed(
      s,
      eventKey
    );

    safeLog(
      "event",
      event
    );

    return event;
  };

  // ---------------------------------------------------------------------------
  // Derived social state
  // ---------------------------------------------------------------------------

  const alignment = (
    karma
  ) => {
    if (karma <= -70)
      return "Villainous";

    if (karma <= -30)
      return "Ruthless";

    if (karma < 30)
      return "Neutral";

    if (karma < 70)
      return "Benevolent";

    return "Heroic";
  };

  const reputation = (
    s
  ) => {
    if (
      !s.deeds.length &&
      s.publicScore === 0
    ) {
      return "Unknown";
    }

    if (s.publicScore <= -70)
      return "Infamous";

    if (s.publicScore <= -30)
      return "Feared";

    if (s.publicScore < 30)
      return "Unknown";

    if (s.publicScore < 70)
      return "Respected";

    return "Admired";
  };

  const perception = (
    s
  ) => {
    const score =
      s.publicScore;

    if (score <= -50)
      return "Fear / Hostility";

    if (score < 0)
      return "Caution / Distrust";

    if (score < 40)
      return "Neutral";

    if (score < 75)
      return "Respect / Trust";

    return "Admiration / Support";
  };

  const authorities = (
    s
  ) => {
    if (s.karma <= -60)
      return "Threat";

    if (s.karma >= 40)
      return "Cooperative";

    return "Neutral";
  };

  const status = (s) => ({
    karma: Math.round(
      s.karma
    ),

    alignment:
      alignment(s.karma),

    reputation:
      reputation(s),

    perception:
      perception(s),

    authorities:
      authorities(s),

    publicScore:
      Math.round(
        s.publicScore
      ),
  });

  // ---------------------------------------------------------------------------
  // Story Card
  // ---------------------------------------------------------------------------

  const cardIndexFromState = (
    s
  ) => {
    if (
      !Array.isArray(
        globalThis.storyCards
      )
    ) {
      return -1;
    }

    if (
      isNum(s.cardIndex) &&
      storyCards[
        s.cardIndex
      ] &&
      storyCards[
        s.cardIndex
      ].keys
    ) {
      const k =
        storyCards[
          s.cardIndex
        ].keys;

      if (
        (Array.isArray(k) &&
          k.indexOf(
            SENTINEL
          ) >= 0) ||
        k === SENTINEL
      ) {
        return s.cardIndex;
      }
    }

    for (
      let i = 0;
      i < storyCards.length;
      i++
    ) {
      const card =
        storyCards[i];

      if (!card) continue;

      const keys =
        card.keys;

      if (
        (Array.isArray(keys) &&
          keys.indexOf(
            SENTINEL
          ) >= 0) ||
        keys === SENTINEL
      ) {
        return i;
      }
    }

    return -1;
  };

  const renderCard = (
    s
  ) => {
    const st =
      status(s);

    const lines = [
      AID_KARMA_CONFIG.cardHeader,
      "",
      `KARMA: ${st.karma}`,
      `MORAL ALIGNMENT: ${st.alignment}`,
      `REPUTATION: ${st.reputation}`,
      `PUBLIC PERCEPTION: ${st.perception}`,
      `AUTHORITIES: ${st.authorities}`,
      "",
      "RECENT KARMA EVENTS:",
    ];

    const recent =
      s.events
        .slice(-8)
        .reverse();

    if (!recent.length) {
      lines.push(
        "No significant moral events recorded yet."
      );
    } else {
      for (const e of recent) {
        const sign =
          e.delta >= 0
            ? "+"
            : "";

        lines.push(
          `${sign}${e.delta} — ${e.label} [${e.visibility}]`
        );
      }
    }

    lines.push(
      "",
      "IMPORTANT KNOWN DEEDS:"
    );

    const deeds =
      s.deeds
        .slice(-8)
        .reverse();

    if (!deeds.length) {
      lines.push("None.");
    } else {
      for (const d of deeds) {
        const mark =
          d.visibility ===
          "public"
            ? "PUBLIC"
            : "WITNESSED";

        lines.push(
          `• ${d.label} [${mark}]`
        );
      }
    }

    lines.push(
      "",
      "SYSTEM NOTE:",
      "Karma tracks what the player actually did. Reputation and public perception reflect what other people can plausibly know."
    );

    return lines.join(
      "\n"
    );
  };

  // ---------------------------------------------------------------------------
  // Story Card management
  // ---------------------------------------------------------------------------

  const ensureCard = (
    s
  ) => {
    if (
      !AID_KARMA_CONFIG.cardEnabled ||
      !Array.isArray(
        globalThis.storyCards
      )
    ) {
      return;
    }

    try {
      let idx =
        cardIndexFromState(
          s
        );

      const entry =
        renderCard(s);

      if (idx < 0) {
        try {
          addStoryCard(
            SENTINEL,
            entry,
            AID_KARMA_CONFIG.cardType
          );
        } catch (err) {
          safeLog(
            "addStoryCard failed",
            String(err)
          );

          return;
        }

        idx =
          cardIndexFromState(
            s
          );
      }

      if (
        idx < 0 &&
        storyCards.length
      ) {
        const possible =
          storyCards.length -
          1;

        if (
          storyCards[
            possible
          ] &&
          storyCards[
            possible
          ].keys ===
            SENTINEL
        ) {
          idx = possible;
        }
      }

      if (idx >= 0) {
        s.cardIndex =
          idx;

        try {
          updateStoryCard(
            idx,
            SENTINEL,
            entry,
            AID_KARMA_CONFIG.cardType
          );
        } catch (err) {
          try {
            storyCards[
              idx
            ].keys = SENTINEL;

            storyCards[
              idx
            ].entry = entry;

            storyCards[
              idx
            ].type =
              AID_KARMA_CONFIG.cardType;
          } catch (
            inner
          ) {
            safeLog(
              "card update failed",
              String(inner)
            );
          }
        }
      }
    } catch (err) {
      safeLog(
        "ensureCard failed",
        String(err)
      );
    }
  };

  // ---------------------------------------------------------------------------
  // AI context / frontMemory
  // ---------------------------------------------------------------------------

  const buildAIBlock = (
    s
  ) => {
    const st =
      status(s);

    const publicDeeds =
      s.events
        .filter(
          (e) =>
            e.visibility ===
            "public"
        )
        .slice(-5)
        .reverse();

    const witnessed =
      s.events
        .filter(
          (e) =>
            e.visibility ===
            "witnessed"
        )
        .slice(-3)
        .reverse();

    const lines = [
      "[Persistent Karma & Reputation System]",

      `Player moral state: Karma ${st.karma} (${st.alignment}).`,

      `General reputation: ${st.reputation}. Public perception: ${st.perception}.`,

      `Authorities: ${st.authorities}.`,

      s.activeScene &&
      s.activeScene.active
        ? "A recent rescue/protection situation is active; related defensive actions should be treated as part of the same moral event unless clearly independent."
        : "",

      "Treat significant deeds below as established world facts.",

      "NPCs may react to the player's reputation even without a Story Card, but specific knowledge must remain plausible.",

      "Do not make every NPC mention the player's reputation; reveal it naturally through trust, admiration, fear, caution, support, avoidance, gossip, or cooperation.",

      "Positive reputation can lead to spontaneous admiration, people offering help, defending the player, or seeking them out.",

      "Negative reputation can lead to distrust, fear, refusal of help, people alerting authorities, or treating the player as dangerous.",

      "Do not let NPCs know private deeds unless they witnessed them, were told, or have another plausible reason to know.",

      "Do not change Karma merely because an NPC has an opinion. Only significant player actions tracked by this system change it.",
    ];

    if (
      publicDeeds.length
    ) {
      lines.push(
        "Publicly known deeds:"
      );

      for (
        const e of publicDeeds
      ) {
        lines.push(
          `- ${e.label}`
        );
      }
    }

    if (
      witnessed.length
    ) {
      lines.push(
        "Recent witnessed deeds (use only for NPCs plausibly present or informed):"
      );

      for (
        const e of witnessed
      ) {
        lines.push(
          `- ${e.label}`
        );
      }
    }

    return lines.join(
      " "
    );
  };

  const writeFrontMemory = (
    s
  ) => {
    if (
      !AID_KARMA_CONFIG.injectFrontMemory
    ) {
      return;
    }

    try {
      if (
        !state.memory ||
        typeof state.memory !==
          "object"
      ) {
        state.memory = {};
      }

      const block =
        `${FRONT_START} ${buildAIBlock(s)} ${FRONT_END}`;

      const existing =
        typeof state.memory
          .frontMemory ===
        "string"
          ? state.memory
              .frontMemory
          : "";

      const withoutOld =
        existing
          .replace(
            new RegExp(
              `${escapeRegex(
                FRONT_START
              )}[\\s\\S]*?${escapeRegex(
                FRONT_END
              )}\\s*`,
              "g"
            ),
            ""
          )
          .trim();

      state.memory.frontMemory =
        withoutOld
          ? `${withoutOld} ${block}`
          : block;
    } catch (err) {
      safeLog(
        "frontMemory failed",
        String(err)
      );
    }
  };

  const injectContext = (
    text,
    s
  ) => {
    const base =
      String(text ?? "");

    const clean =
      base
        .replace(
          new RegExp(
            `${escapeRegex(
              CONTEXT_START
            )}[\\s\\S]*?${escapeRegex(
              CONTEXT_END
            )}\\s*`,
            "g"
          ),
          ""
        )
        .trim();

    const block =
      `${CONTEXT_START}\n${buildAIBlock(s)}\n${CONTEXT_END}`;

    return clean
      ? `${clean}\n\n${block}`
      : block;
  };

  // ---------------------------------------------------------------------------
  // Hook API
  // ---------------------------------------------------------------------------

  const input = (
    text
  ) => {
    try {
      const s =
        ensureState();

      const inputText =
        cleanText(text);

      const actionCount =
        globalThis.info &&
        isNum(
          info.actionCount
        )
          ? info.actionCount
          : s.turn + 1;

      s.turn = Math.max(
        s.turn,
        actionCount
      );

      if (
        s.activeScene &&
        s.turn -
            s.activeScene
              .turn >
          AID_KARMA_CONFIG.maxActiveSceneTurns
      ) {
        s.activeScene =
          null;
      }

      // If the previous generation never reached Output,
      // conservatively settle that pending action on the next player input.
      if (
        s.pending &&
        s.pending.key &&
        !s.pending.resolved
      ) {
        if (
          !alreadyProcessed(
            s,
            s.pending.key
          )
        ) {
          const candidates =
            Array.isArray(
              s.pending
                .candidates
            )
              ? s.pending
                  .candidates
              : [];

          for (
            const raw of candidates
          ) {
            const c =
              rebuildCandidate(
                raw
              );

            if (c) {
              addEvent(
                s,
                s.pending.input,
                "",
                c,
                "witnessed",
                `${s.pending.key}:${c.rule.id}`,
                true
              );
            }
          }
        }

        s.pending =
          null;
      }

      const candidates =
        detectCandidates(
          inputText
        );

      const key =
        `${actionCount}:${hash32(
          inputText
        )}`;

      s.pending = {
        key,

        input:
          inputText.slice(
            0,
            800
          ),

        candidates:
          candidates.map(
            (c) => ({
              ruleId:
                c.rule.id,

              delta:
                c.delta,

              verb:
                c.rule.verb ||
                c.rule.label,

              matched:
                c.matched,

              sentence:
                c.sentence,

              attempted:
                c.attempted,

              target:
                c.target || "",

              description:
                c.description,
            })
          ),

        resolved: false,
      };

      writeFrontMemory(
        s
      );

      ensureCard(s);

      safeLog(
        "input",
        {
          turn: s.turn,
          actionCount,
          key,
          candidates:
            s.pending
              .candidates,
        }
      );

      return text;
    } catch (err) {
      safeLog(
        "input error",
        String(err)
      );

      return text || " ";
    }
  };

  const context = (
    text,
    _stop
  ) => {
    try {
      const s =
        ensureState();

      const finalText =
        injectContext(
          text,
          s
        );

      safeLog(
        "context",
        {
          karma: s.karma,
        }
      );

      return {
        text: finalText,
        stop: false,
      };
    } catch (err) {
      safeLog(
        "context error",
        String(err)
      );

      return {
        text: text || "",
        stop: false,
      };
    }
  };

  const rebuildCandidate = (
    raw
  ) => {
    if (
      !raw ||
      typeof raw !==
        "object"
    ) {
      return null;
    }

    const rule =
      ACTION_RULES.find(
        (r) =>
          r.id ===
          raw.ruleId
      );

    if (!rule) return null;

    return {
      rule,

      delta: isNum(
        raw.delta
      )
        ? raw.delta
        : rule.delta,

      verb:
        raw.verb ||
        rule.verb ||
        rule.label,

      matched:
        raw.matched || "",

      sentence:
        raw.sentence || "",

      attempted:
        !!raw.attempted,

      target:
        raw.target || "",

      description:
        raw.description ||
        (raw.attempted
          ? `Attempted to ${
              raw.verb ||
              rule.verb ||
              rule.label
            }.`
          : rule.label),
    };
  };

  const output = (
    text
  ) => {
    try {
      const s =
        ensureState();

      const outText =
        String(text ?? "");

      if (
        s.pending &&
        s.pending.key
      ) {
        const actionKey =
          s.pending.key;

        if (
          !alreadyProcessed(
            s,
            actionKey
          )
        ) {
          let candidates =
            (
              s.pending
                .candidates ||
              []
            )
              .map(
                rebuildCandidate
              )
              .filter(Boolean);

          let sourceText =
            s.pending.input;

          // Fallback for vague player inputs such as "Do it".
          // Generated narration can contain the explicit action.
          if (
            !candidates.length &&
            /\b(?:you|i|the player|player character)\b/i.test(
              outText
            )
          ) {
            candidates =
              detectCandidates(
                outText
              );

            sourceText =
              outText;
          }

          // If a rescue scene is active, allow the generated output
          // to complete the same rescue sequence.
          if (
            !candidates.length &&
            s.activeScene &&
            s.activeScene.active &&
            s.turn -
                s.activeScene
                  .turn <=
              AID_KARMA_CONFIG.maxActiveSceneTurns
          ) {
            const rescueCandidates =
              detectCandidates(
                outText
              ).filter(
                (c) =>
                  isRescueRule(c)
              );

            if (
              rescueCandidates.length
            ) {
              candidates =
                rescueCandidates;

              sourceText =
                outText;
            }
          }

          const visibility =
            inferVisibility(
              sourceText,
              outText
            );

          for (
            const c of candidates
          ) {
            addEvent(
              s,
              sourceText,
              outText,
              c,
              visibility,
              `${actionKey}:${c.rule.id}`,
              false
            );
          }

          s.pending.resolved =
            true;
        }

        s.pending =
          null;
      }

      writeFrontMemory(
        s
      );

      ensureCard(s);

      safeLog(
        "output",
        status(s)
      );

      return text || " ";
    } catch (err) {
      safeLog(
        "output error",
        String(err)
      );

      return text || " ";
    }
  };

  return {
    input,
    context,
    output,

    status: () =>
      status(
        ensureState()
      ),

    debugState: () =>
      ensureState(),

    buildAIBlock: () =>
      buildAIBlock(
        ensureState()
      ),

    renderCard: () =>
      renderCard(
        ensureState()
      ),
  };
})();
