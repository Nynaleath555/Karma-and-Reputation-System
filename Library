        /\b(?:help(?:ed|s|ing)?|assist(?:ed|s|ing)?)\s+(?:him|her|them|someone|somebody|the victim|the civilian|the woman|the man|[A-Z][a-z]+)\s+(?:to|toward|towards)\s+(?:safety|escape|an exit)\b/i,

        /\b(?:get|got|getting|lead|led|leading|guide|guided|guiding|escort|escorted|escorting|carry|carried|carrying|pull|pulled|pulling)\s+(?:him|her|them|someone|somebody|the victim|the civilian|the woman|the man|[A-Z][a-z]+)\s+(?:to|into|out of|away from)\s+(?:safety|danger|the danger|the area|there|here)\b/i,

        /\b(?:save[sd]?|rescue[sd]?|protect(?:ed|s|ing)?|defend(?:ed|s|ing)?|shield(?:ed|s|ing)?)\s+(?:him|her|them|someone|somebody|the victim|the civilian|the woman|the man|[A-Z][a-z]+)\b[\s\S]{0,60}\b(?:attacker|attackers|assailant|assailants|mugger|muggers|criminal|criminals|threat|danger|being attacked)\b/i,

        /\b(?:drive|drove|driving|force|forced|forcing|push|pushed|pushing)\s+(?:the|his|her|their)?\s*(?:attacker|attackers|assailant|assailants|mugger|muggers|criminal|criminals)\s+(?:away|back|off)\b/i,

        /\b(?:stop(?:ped|s)?|prevent(?:ed|s)?)\s+(?:the|an?|two|three|several|the two)?\s*(?:attacker|attackers|assailant|assailants|mugger|muggers)\b/i,
