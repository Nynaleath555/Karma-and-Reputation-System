      patterns: [
        /\b(?:attack(?:ed|s|ing)?|assault(?:ed|s|ing)?|punch(?:ed|es|ing)?|kick(?:ed|s|ing)?|struck|stab(?:bed|s|bing)?|shot|shoot(?:s|ing)? .* (?:at|him|her|them))\b/i,
      ],
