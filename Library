  const FRONT_END = "[AID_KARMA_END]";
  const CONTEXT_START = "[AID_KARMA_CONTEXT]";
  const CONTEXT_END = "[/AID_KARMA_CONTEXT]";

  // ---------------------------------------------------------------------------
  // Utilities
  // ---------------------------------------------------------------------------

  const isNum = (v) => typeof v === "number" && Number.isFinite(v);
  const clamp = (v, lo, hi) =>
    !isNum(v) ? lo : Math.max(lo, Math.min(hi, v));

  const cleanText = (v) =>
    String(v ?? "").replace(/\s+/g, " ").trim();

  const lower = (v) => cleanText(v).toLowerCase();

  const cap = (v) => {
    const s = cleanText(v);
    return s ? s.charAt(0).toUpperCase() + s.slice(1) : s;
  };

  const hash32 = (value) => {
    const s = String(value ?? "");
    let h = 2166136261;

    for (let i = 0; i < s.length; i++) {
      h ^= s.charCodeAt(i);
      h =
        (h +
          ((h << 1) +
            (h << 4) +
            (h << 7) +
            (h << 8) +
            (h << 24))) >>>
        0;
    }

    return h >>> 0;
  };

  const escapeRegex = (value) =>
    String(value).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

  const safeLog = (...args) => {
    if (!AID_KARMA_CONFIG.debug) return;

    try {
      log(
        "[Karma] " +
          args
            .map((x) => {
              if (typeof x === "string") return x;

              try {
                return JSON.stringify(x);
              } catch (_) {
                return String(x);
              }
            })
            .join(" ")
      );
    } catch (_) {}
  };

  const localClause = (src, at) => {
    const text = String(src ?? "");
    const start = Math.max(0, at - 120);
    const tail = text.slice(start, at);

    const cut = tail.search(/[.!?;:\n][^.!?;:\n]*$/);

    return cut >= 0 ? tail.slice(cut + 1) : tail;
  };

  const sentenceAt = (src, at) => {
    const text = String(src ?? "");

    const starts = [
      text.lastIndexOf(".", at - 1),
      text.lastIndexOf("!", at - 1),
      text.lastIndexOf("?", at - 1),
      text.lastIndexOf("\n", at - 1),
    ];

    const start = Math.max(...starts) + 1;

    const ends = [
      text.indexOf(".", at),
      text.indexOf("!", at),
      text.indexOf("?", at),
      text.indexOf("\n", at),
    ].filter((x) => x >= 0);

    const end = ends.length ? Math.min(...ends) : text.length;

    return text.slice(start, end).trim();
  };

  // ---------------------------------------------------------------------------
  // Narrative-context filters
  // ---------------------------------------------------------------------------

  const NEGATORS =
    /\b(?:not|never|cannot|can't|won't|wouldn't|don't|doesn't|didn't|refus\w*|declin\w*|avoid\w*|without|instead of|rather than|unable to|fail\w* to|failed to|decid\w* against)\b/i;

  const ATTEMPT_WORDS =
    /\b(?:try|tries|tried|attempt|attempted|attempts|plan(?:ned)? to)\b/i;

  const HISTORICAL_MARKERS =
    /\b(?:years? ago|months? ago|weeks? ago|days? ago|last year|last month|last week|in the past|in my past|in his past|in her past|back then|long ago|when i was younger|when we were younger|when i was young|when we were young|once upon a time|previously|formerly|earlier|before the story began|before this story began|before the game began|before we met|before you met|before they met|as a child|as a teenager|growing up|years? earlier|months? earlier|weeks? earlier|days? earlier|before returning to the present|before the present|before reality changed|in the timeline i remember|in the timeline you remember)\b/i;

  const TIME_TRAVEL_PAST =
    /\b(?:travel(?:ed|led)?|went|go|returned|return(?:ed|ing)?|was sent|had been sent|sent|transport(?:ed|ing)?|thrown|threw)\b[\s\S]{0,120}\b(?:into|back|in)\s+the\s+past\b/i;

  const TIME_TRAVEL_ALTERNATES =
    /\b(?:time[- ]travel(?:ed|led)?|traveled back in time|travelled back in time|went back in time|returned to the past|returned from the past)\b/i;

  const FLASHBACK_MARKERS =
    /\b(?:flashback|flash back|memory|memories|remembered|remembering|recalled|recalling|dreamed of|dreams of)\b/i;

  const HYPOTHETICAL_MARKERS =
    /\b(?:if|unless|would|could|might|may|should|imagine|suppose|hypothetically|what if|i would|i could|i might|i may|i should|i plan to|i intend to|i want to|i hope to|i am going to|i'm going to)\b/i;

  const isNegated = (src, at) =>
    NEGATORS.test(localClause(src, at));

  const isAttempted = (src, at) =>
    ATTEMPT_WORDS.test(localClause(src, at));

  const isHistorical = (src, at) => {
    const sentence = sentenceAt(src, at);
    const before = localClause(src, at);
    const combined = `${sentence} ${before}`;

    if (TIME_TRAVEL_PAST.test(combined)) return true;
    if (TIME_TRAVEL_ALTERNATES.test(combined)) return true;
    if (HISTORICAL_MARKERS.test(combined)) return true;
    if (FLASHBACK_MARKERS.test(combined)) return true;

    if (
      /\b(?:you|i)\s+(?:had|had already|used to)\b/i.test(
        combined
      )
    ) {
      return true;
    }

    return false;
  };

  const isHypothetical = (src, at) => {
    const sentence = sentenceAt(src, at);
    const before = localClause(src, at);

    return HYPOTHETICAL_MARKERS.test(
      `${sentence} ${before}`
    );
  };

  const PREVENTIVE =
    /\b(?:stop(?:ped|s)?|prevent(?:ed|s)?|defus(?:e|ed|es|ing)|disarm(?:ed|s|ing)?|save(?:d|s|ing)?)\b[\s\S]{0,60}$/i;

  const isPrevented = (src, at) =>
    PREVENTIVE.test(localClause(src, at));

  const OBSERVING =
    /\b(?:watch(?:es|ed|ing)?|witness(?:ed|es|ing)?|observ(?:e|ed|es|ing)|see(?:s|ing|n)?|saw|hear(?:d|s|ing)?|listen(?:ed|s|ing)?)\b/i;

  const OTHER_ACTOR =
    /\b(?:he|she|they|someone else|the villain|the enemy|the guard|the criminal|the officer|the soldier|a man|a woman|a person|another)\b/i;

  const isObservedAnotherActor = (src, at) => {
    const clause = localClause(src, at);

    return (
      OBSERVING.test(clause) &&
      OTHER_ACTOR.test(clause)
    );
  };

  // ---------------------------------------------------------------------------
  // Player agency detection
  // ---------------------------------------------------------------------------

  const PLAYER_PRONOUN =
    /\b(?:i|i'm|i am|i'd|i'll|i have|i had|i've|my|mine|me|you|your|the player|player character)\b/i;

  const PLAYER_ACTION_START =
    /^(?:save|rescue|help|protect|defend|shield|spare|forgive|arrest|capture|stop|prevent|defuse|disarm|kill|murder|attack|assault|steal|rob|burn|destroy|kidnap|torture|threaten|betray|sabotage|throw|push|pull|hit|strike|shoot|stab|use|grab|carry|lead|guide|escort|evacuate)\b/i;

  const PLAYER_ACTION_WORDS =
    /(?:save|rescue|help|protect|defend|shield|spare|forgive|arrest|capture|stop|prevent|defuse|disarm|kill|murder|attack|assault|steal|rob|burn|destroy|kidnap|torture|threaten|betray|sabotage|throw|push|pull|hit|strike|shoot|stab|use|grab|carry|lead|guide|escort|evacuate)\b/i;

  const playerSubjectLikely = (text) => {
    const s = String(text ?? "").trim();

    if (!s) return false;

    if (PLAYER_PRONOUN.test(s)) return true;

    if (PLAYER_ACTION_START.test(s)) return true;

    // More permissive than v3:
    // detect player agency anywhere in the input rather than only
    // at the beginning.
    if (
      /\b(?:i|you|we|my character|the player|player character)\b[\s\S]{0,220}?(?:save|rescue|help|protect|defend|shield|spare|forgive|arrest|capture|stop|prevent|defuse|disarm|kill|murder|attack|assault|steal|rob|burn|destroy|kidnap|torture|threaten|betray|sabotage|throw|push|pull|hit|strike|shoot|stab|use|grab|carry|lead|guide|escort|evacuate)\b/i.test(
        s
      )
    ) {
      return true;
    }

    return false;
  };

  const findFirstMatch = (text, patterns) => {
    const src = String(text ?? "");

    for (const re of patterns) {
      re.lastIndex = 0;

      const m = re.exec(src);

      if (m) {
        return {
          match: m[0],
          index: m.index,
        };
      }
    }

    return null;
  };

  const playerOwnsMatch = (text, index) => {
    const src = String(text ?? "");
    const clause = localClause(src, index);

    if (PLAYER_PRONOUN.test(clause)) return true;

    if (
      index <= 12 &&
      PLAYER_ACTION_START.test(cleanText(src))
    ) {
      return true;
    }

    const sentence = sentenceAt(src, index);

    const tail = sentence.slice(
      0,
      Math.max(
        0,
        sentence.length -
          String(src).slice(index).length
      )
    );

    if (PLAYER_PRONOUN.test(tail)) return true;

    // Player agency anywhere in the same sentence.
    if (
      PLAYER_PRONOUN.test(sentence) &&
      PLAYER_ACTION_WORDS.test(sentence)
    ) {
      return true;
    }

    return false;
  };

  // ---------------------------------------------------------------------------
  // Action rules
  // ---------------------------------------------------------------------------

  const ACTION_RULES = [
    {
      id: "terrorism",
      delta: -55,
      label: "committed a terrorist attack",
      verb: "commit a terrorist attack",
      group: "extreme",

      patterns: [
        /\bterror(?:ist|ism)\b/i,

        /\b(?:bombed|bombing|bombs|detonated|detonate|explod(?:ed|ing|e)|massacre|mass killing|mass murder)\b/i,
